{
  "manifest_version": 3,
  "name": "BOGI Promptr",
  "version": "0.4.0",
  "description": "Помощник для копирования промптов и импорта вручную скачанных файлов в content/<миф>/. С Flow НЕ взаимодействует.",
  "permissions": ["sidePanel", "downloads", "storage", "clipboardWrite", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "BOGI Promptr"
  }
}
