# Медиафайлы (генерируемые) — одиночные мифы и части сериалов
content/*/voiceover/audio/
content/*/images/
content/*/video/
content/*/music/
content/*/final/
# Сериал: content/<Цикл>/часть_NN_<тема>/...
content/*/*/voiceover/audio/
content/*/*/images/
content/*/*/video/
content/*/*/music/
content/*/*/final/

# Ящик Пандоры — старый формат, всё тяжёлое
content/ящик_пандоры/*.mp4
content/ящик_пандоры/*.mp3
content/ящик_пандоры/*.png
content/ящик_пандоры/*.zip
content/Ящик Пандоры/*.mp4
content/Ящик Пандоры/*.mp3
content/Ящик Пандоры/*.png
content/Ящик Пандоры/*.zip

# Браузерный профиль автоматизации
automation/.browser_profile/

# Логи установки CosyVoice + временные TTS-файлы обучения
automation/_setup_logs/
automation/TTS_AUDIO_FOR_TRAIN.mp3
automation/TTS_SPEECH_TEXT
automation/__pycache__/

# Webapp: выбор пользователя — per-machine state, не надо в репо
webapp/selections/
webapp/__pycache__/

# Временные файлы
tmp_video_frames/
mockups/
external/
__pycache__/
*.pyc

# Claude Code / инструменты
.claude/
.tools/
.venvs/

# Системные
.DS_Store
Thumbs.db

# Архив — готовые видео и архивы, слишком тяжёлые для GitHub (>100 MB)
content/архив/**/*.mp4
content/архив/**/*.zip
content/архив/**/*.mp3

# Аудио и видео ассеты, не нужные в репо
assets/music/
assets/TTS/

# Папки не для репо
кисы/
конкуренты/

# Временные файлы webapp
webapp/static/_mockups/
